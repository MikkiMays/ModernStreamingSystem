{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cord:contracts:server-catalog.v1",
  "title": "Каталог серверов Cord, формат cord.servers/1",
  "description": "Полезная нагрузка JWS, который отдаёт GET /api/v1/catalog (ADR 0001 §8, П4). Конверт — $defs.envelope: JWS в JSON-сериализации (RFC 7515), alg EdDSA (RFC 8037); подписываются точные байты payload, ключи — contracts/catalog-keys.json. Клиент принимает каталог, только если подпись верна любым ключом списка, seq не меньше последнего принятого и expiresAt плюс 30 дней ещё не прошёл; иначе остаётся последний хороший. Неизвестные поля клиент пропускает, подписывающий скрипт (scripts/sign-catalog.mjs) — отклоняет.",
  "type": "object",
  "required": ["format", "seq", "issuedAt", "expiresAt", "servers"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "cord.servers/1" },
    "seq": { "type": "integer", "minimum": 0, "description": "Номер выпуска каталога; только растёт — защита от отката." },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time", "description": "Срок; клиент держит каталог ещё 30 дней льготы." },
    "servers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/server" },
      "contains": { "type": "object", "required": ["default"], "properties": { "default": { "const": true } } },
      "minContains": 1,
      "maxContains": 1,
      "description": "Порядок показа — по order; ровно один сервер с default: true. id не повторяются."
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "required": ["id", "name", "country", "url", "order"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$", "description": "Не меняется у сервера никогда." },
        "name": {
          "type": "object",
          "required": ["ru"],
          "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 40 },
          "description": "Имя по языкам П9; ru обязателен."
        },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2 — по нему круглый флаг." },
        "url": { "type": "string", "pattern": "^https://[a-z0-9.-]+(:[0-9]{1,5})?/$", "description": "https-origin с путём /, разбор как ServerEndpoint.Parse." },
        "order": { "type": "number", "description": "По возрастанию." },
        "default": { "type": "boolean", "default": false, "description": "Сервер первого запуска." }
      }
    },
    "envelope": {
      "type": "object",
      "required": ["payload", "signatures"],
      "properties": {
        "payload": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "description": "base64url(UTF-8 JSON по этой схеме)." },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["protected", "signature"],
            "properties": {
              "protected": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "description": "base64url({\"alg\":\"EdDSA\",\"kid\":\"<sha-256 SPKI>\"})." },
              "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$", "description": "Ed25519 над ASCII «protected.payload», 64 байта base64url." }
            }
          }
        }
      }
    }
  }
}
