  },
  {
   "id": "te029",
   "type": "text",
   "x": 190,
   "y": 885,
   "width": 860.2,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
