  {
   "id": "te0058",
   "type": "text",
   "x": 1730.2,
   "y": 2031.0,
   "width": 524.2,
   "height": 81.2,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
