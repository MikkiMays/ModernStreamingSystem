  {
   "id": "te0056",
   "type": "text",
   "x": 537.2,
   "y": 2031.0,
   "width": 509.6,
   "height": 81.2,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "frstages",
