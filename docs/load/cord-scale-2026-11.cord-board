  {
   "id": "te0057",
   "type": "text",
   "x": 1166.4,
   "y": 2039.1,
   "width": 451.4,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
