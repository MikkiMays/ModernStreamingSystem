   "isDeleted": false,
   "boundElements": [],
   "updated": 1793617796494,
   "link": null,
   "locked": false,
   "index": null,
   "text": "1000 активных сейчас ≈ 8 Гбит/с,\n≈ 47 ядер → 11 × AX42 ≈ €1 100/мес;\nпосле оптимизаций ≈ 4 Гбит/с, 6 узлов",
   "originalText": "1000 активных сейчас ≈ 8 Гбит/с,\n≈ 47 ядер → 11 × AX42 ≈ €1 100/мес;\nпосле оптимизаций ≈ 4 Гбит/с, 6 узлов",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "nn6",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "nst0",
   "type": "rectangle",
   "x": 511.9,
   "y": 2016.0,
   "width": 560.2,
