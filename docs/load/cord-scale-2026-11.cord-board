  {
   "id": "te0059",
   "type": "text",
   "x": 2374.1,
   "y": 2039.1,
   "width": 436.8,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
