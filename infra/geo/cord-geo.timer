[Unit]
# Два раза в месяц, ночью.
#
# ПОЧЕМУ ТАК. DB-IP Lite выходит раз в месяц, в первые его дни. 3-е число — файл месяца уже выложен; 17-е —
# вторая попытка, если 3-го сеть или сайт не ответили, и свежий список ASN хостеров. Чаще незачем: адреса
# переезжают между странами и провайдерами медленно, а служба и со старой базой работает.
#
# 04:40 — не ровный час и не время уборки (`cord-tidy.timer`, 05:10). Persistent=true — если сервер был
# выключен, обновление случится при включении.
Description=Cord geo twice a month

[Timer]
OnCalendar=*-*-03,17 04:40:00
Persistent=true
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
