[Unit]
# Стена сети плеера страниц кинозала: из подсети контейнера `sniffer` нельзя открыть новое соединение в
# частные сети хоста. Что именно и почему — в шапке скрипта. Правила iptables живут до перезагрузки, и
# после неё их ставит эта единица — сразу за docker, который создаёт цепочку DOCKER-USER.
Description=Cord page player — network wall for the sniffer subnet
Documentation=file:@CORD_ROOT@/infra/sniffer-firewall.sh
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@CORD_ROOT@
ExecStart=/usr/bin/env bash @CORD_ROOT@/infra/sniffer-firewall.sh apply
# Остановка единицы правил не снимает нарочно: без них плеер страниц был бы в сети хоста без стены.
# Снять — только руками: sudo bash infra/sniffer-firewall.sh remove

[Install]
WantedBy=multi-user.target
