      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "clamp(1 + 0.035 * (93.2 - (0.024 * (max(cord_probe_rtt_ms) / 2 + max(cord_probe_jitter_ms{leg=\"down\"}) + 60) + 0.11 * clamp_min((max(cord_probe_rtt_ms) / 2 + max(cord_probe_jitter_ms{leg=\"down\"}) + 60) - 177.3, 0)) - (95 * (max(cord_probe_loss_ratio{leg=\"down\"}) * 100) / ((max(cord_probe_loss_ratio{leg=\"down\"}) * 100) + 10))) + 0.000007 * (93.2 - (0.024 * (max(cord_probe_rtt_ms) / 2 + max(cord_probe_jitter_ms{leg=\"down\"}) + 60) + 0.11 * clamp_min((max(cord_probe_rtt_ms) / 2 + max(cord_probe_jitter_ms{leg=\"down\"}) + 60) - 177.3, 0)) - (95 * (max(cord_probe_loss_ratio{leg=\"down\"}) * 100) / ((max(cord_probe_loss_ratio{leg=\"down\"}) * 100) + 10))) * ((93.2 - (0.024 * (max(cord_probe_rtt_ms) / 2 + max(cord_probe_jitter_ms{leg=\"down\"}) + 60) + 0.11 * clamp_min((max(cord_probe_rtt_ms) / 2 + max(cord_probe_jitter_ms{leg=\"down\"}) + 60) - 177.3, 0)) - (95 * (max(cord_probe_loss_ratio{leg=\"down\"}) * 100) / ((max(cord_probe_loss_ratio{leg=\"down\"}) * 100) + 10))) - 60) * (100 - (93.2 - (0.024 * (max(cord_probe_rtt_ms) / 2 + max(cord_probe_jitter_ms{leg=\"down\"}) + 60) + 0.11 * clamp_min((max(cord_probe_rtt_ms) / 2 + max(cord_probe_jitter_ms{leg=\"down\"}) + 60) - 177.3, 0)) - (95 * (max(cord_probe_loss_ratio{leg=\"down\"}) * 100) / ((max(cord_probe_loss_ratio{leg=\"down\"}) * 100) + 10)))), 1, 4.5)",
          "legendFormat": "Оценка MOS (куратор)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
