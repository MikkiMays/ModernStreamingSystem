[Unit]
# Раз в сутки, ночью.
#
# ПОЧЕМУ НЕ ЧАЩЕ. Всё, что убирается, появляется от действий человека: выпуск клиента,
# обновление сервера, пересборка. Между ними убирать нечего, а докер за проход спрашивают
# трижды. Место при этом не кончится: то, что копится само — журналы контейнеров и база —
# ограничено сверху, а не уборкой (`compose.yaml`, `stream.total-max-bytes`).
#
# ПОЧЕМУ НЕ РЕЖЕ. Один выпуск клиента — 400 МБ, одно обновление — до полутора гигабайт
# образов отката. Неделя тишины между уборками означает, что кончиться диск успеет.
#
# 05:10 — не ровный час: ровные заняты чужими таймерами (apt, fwupd, logrotate), и
# сходиться с ними на одном диске незачем. Persistent=true — если сервер был выключен,
# уборка случится при включении, а не пропустится молча.
Description=Cord tidy daily

[Timer]
OnCalendar=*-*-* 05:10:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
