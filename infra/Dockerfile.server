FROM maven:3.9.11-eclipse-temurin-25@sha256:407c4423cec0cf2981055bc2c6c0dc211d9605b6669279b95997f2d1c7e91e2c AS build
WORKDIR /workspace
COPY pom.xml ./
COPY server/pom.xml server/pom.xml
RUN mvn -B -q -pl server -am dependency:go-offline
COPY server/src server/src
# Реестр кодов ошибок — в jar (server/pom.xml): им ядро ограничивает коды счётчика ошибок клиента.
COPY contracts/errors.json contracts/errors.json
# Подписанный каталог серверов (ADR 0001 §8) — pom.xml кладёт его в jar.
RUN mvn -B -q -pl server -am package -DskipTests

FROM eclipse-temurin:25.0.5_8-jre-alpine@sha256:56f273059de6b13a6b49fe0ded691ed2d0399bbee76156a8f2d385f7524a3d43
RUN addgroup -g 10001 stream && adduser -D -u 10001 -G stream stream
WORKDIR /app
COPY --from=build /workspace/server/target/streaming-server-0.1.0-SNAPSHOT.jar /app/server.jar
USER 10001:10001
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=65 -XX:+ExitOnOutOfMemoryError"
ENTRYPOINT ["java","-jar","/app/server.jar"]
