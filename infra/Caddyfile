{
	admin off
	auto_https off
	persist_config off
	# Метрики HTTP шлюза для профиля `monitoring` (E10-B): запросы, статусы, задержки. Без `per_host`:
	# имя хоста у Cord одно-два, а меток с чужими именами из заголовка Host быть не должно.
	metrics
	servers 127.0.0.1:{$GATEWAY_PORT:8091} {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
				fallback_policy reject
			}
		}
	}
}

# Одна политика на все страницы; меняется только то, кому можно показать страницу в рамке
# (`frame-ancestors`, аргумент снипета).
(csp) {
	# Совместный просмотр ничего здесь не просит, и это следствие того, как он устроен:
	# видео достаёт сервер и отдаёт его со своего адреса, а страница играет обычный
	# `<video>`. Чужих скриптов и рамок нет — значит, и послаблений не нужно.
	Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self' https://{$RTC_HOST} wss://{$RTC_HOST}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors {args[0]}"
}

(headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
	}
	# В рамку — никому, кроме одного документа. Mini App Telegram (`/tg`, E09, решение архитектора 17)
	# Telegram Web (Web A и Web K на web.telegram.org) открывает в iframe; телефоны и Desktop — в своём
	# WebView, им рамка не нужна. Политика та же, `script-src 'self'` тоже: SDK Mini App — в нашем
	# бандле, а не скриптом с telegram.org. Проверка — `infra/csp-check.sh`.
	@framed not path /tg /tg/
	header @framed {
		X-Frame-Options DENY
		import csp 'none'
	}
	@telegram path /tg /tg/
	header @telegram {
		import csp https://web.telegram.org
	}
}

# Signaling is selected by path, not by name, so it can be served on the application
# host as well. In simple and ip mode RTC_HOST equals APP_HOST and the @rtc site below
# is never reached; the app block has to carry /rtc itself or signaling would fall
# through to the SPA handler and return index.html to the SFU client.
(signaling) {
	@signaling path /rtc /rtc/*
	handle @signaling {
		header >Access-Control-Allow-Origin {$PUBLIC_URL}
		forward_auth 127.0.0.1:8080 {
			uri /internal/signaling-auth
			header_up X-Internal-Secret {$INTERNAL_SECRET}
			# Предел подключений сигналинга считается по адресу клиента (A12 docs/abuse-model.md).
			header_up X-Real-IP {remote_host}
			header_up X-Media-Token {query.access_token}
			header_up -X-Forwarded-Uri
		}
		reverse_proxy 127.0.0.1:7880
	}
}

http://:{$GATEWAY_PORT:8091} {
	bind 127.0.0.1
	@app host {$APP_HOST}
	handle @app {
		import headers
		import signaling
		handle_path /downloads/windows/* {
			root * /releases
			header Cache-Control "no-cache"
			file_server
		}
		@services path /api/v1/services/*
		handle @services {
			reverse_proxy 127.0.0.1:18100
		}
		@api path /api/v1/*
		handle @api {
			reverse_proxy 127.0.0.1:8080 {
				header_up X-Internal-Secret {$INTERNAL_SECRET}
				header_up X-Real-IP {remote_host}
				# Эти два заголовка говорят «я служба Cord» и «от имени этого пользователя бота».
				# Браузеру их слать незачем: снаружи они не доходят до ядра вовсе (A14).
				header_up -X-Service-Secret
				header_up -X-Cord-Actor
			}
		}
		handle /uploads/* {
			forward_auth 127.0.0.1:8080 {
				uri /internal/upload-auth
				header_up X-Internal-Secret {$INTERNAL_SECRET}
				header_up X-Original-Uri {uri}
				header_up X-Original-Method {method}
			}
			reverse_proxy 127.0.0.1:1080 {
				header_up X-Forwarded-Proto https
				header_up -X-HTTP-Method-Override
			}
		}
		# Mini App Telegram — отдельный HTML-вход сборки (`web/tg.html`), а не SPA с роутером
		# (решение архитектора 13). Как и index.html, без кэша: он называет хэши текущей сборки.
		@miniapp path /tg /tg/
		handle @miniapp {
			root * /srv
			header Cache-Control "no-cache"
			rewrite * /tg.html
			encode zstd gzip
			file_server
		}
		handle {
			root * /srv
			# Every file under /assets carries a content hash in its name, so a given URL never
			# changes meaning and may be cached indefinitely. index.html must not be: it is the
			# only file naming the current hashes, and a stale copy keeps requesting asset URLs
			# that stopped existing at the last deploy. With no Cache-Control at all the browser
			# guesses from Last-Modified and caches exactly the wrong one of the two.
			@hashed path /assets/*
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			@unhashed not path /assets/*
			header @unhashed Cache-Control "no-cache"
			try_files {path} /index.html
			encode zstd gzip
			file_server
		}
	}
	@rtc host {$RTC_HOST}
	handle @rtc {
		import signaling
		respond 404
	}
	respond 404
}

# Выдача метрик шлюза — только на 127.0.0.1, только для VictoriaMetrics профиля `monitoring`. Снаружи до
# неё не дойти: edge проксирует на `GATEWAY_PORT`, а не сюда. Admin API Caddy по-прежнему выключен.
http://127.0.0.1:{$GATEWAY_METRICS_PORT:2019} {
	bind 127.0.0.1
	# `respond` в порядке директив Caddy стоит раньше `metrics`: без `handle` любой запрос, и /metrics
	# тоже, получал 404.
	handle /metrics {
		metrics
	}
	respond 404
}

http://:{$HOOKS_PORT:8090} {
	bind 127.0.0.1
	@hooks path /internal/tus /internal/livekit
	handle @hooks {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Internal-Secret {$INTERNAL_SECRET}
		}
	}
	respond 404
}
