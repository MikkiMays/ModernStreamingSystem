{
	admin off
	auto_https off
	persist_config off
	servers 127.0.0.1:{$GATEWAY_PORT:8091} {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
				fallback_policy reject
			}
		}
	}
}

(headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self' https://{$RTC_HOST} wss://{$RTC_HOST}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}
}

# Signaling is selected by path, not by name, so it can be served on the application
# host as well. In simple and ip mode RTC_HOST equals APP_HOST and the @rtc site below
# is never reached; the app block has to carry /rtc itself or signaling would fall
# through to the SPA handler and return index.html to the SFU client.
(signaling) {
	@signaling path /rtc /rtc/*
	handle @signaling {
		header >Access-Control-Allow-Origin {$PUBLIC_URL}
		forward_auth 127.0.0.1:8080 {
			uri /internal/signaling-auth
			header_up X-Internal-Secret {$INTERNAL_SECRET}
			header_up X-Media-Token {query.access_token}
			header_up -X-Forwarded-Uri
		}
		reverse_proxy 127.0.0.1:7880
	}
}

http://:{$GATEWAY_PORT:8091} {
	bind 127.0.0.1
	@app host {$APP_HOST}
	handle @app {
		import headers
		import signaling
		handle_path /downloads/windows/* {
			root * /releases
			header Cache-Control "no-cache"
			file_server
		}
		@services path /api/v1/services/*
		handle @services {
			reverse_proxy 127.0.0.1:18100
		}
		@api path /api/v1/*
		handle @api {
			reverse_proxy 127.0.0.1:8080 {
				header_up X-Internal-Secret {$INTERNAL_SECRET}
				header_up X-Real-IP {remote_host}
			}
		}
		handle /uploads/* {
			forward_auth 127.0.0.1:8080 {
				uri /internal/upload-auth
				header_up X-Internal-Secret {$INTERNAL_SECRET}
				header_up X-Original-Uri {uri}
				header_up X-Original-Method {method}
			}
			reverse_proxy 127.0.0.1:1080 {
				header_up X-Forwarded-Proto https
				header_up -X-HTTP-Method-Override
			}
		}
		handle {
			root * /srv
			# Every file under /assets carries a content hash in its name, so a given URL never
			# changes meaning and may be cached indefinitely. index.html must not be: it is the
			# only file naming the current hashes, and a stale copy keeps requesting asset URLs
			# that stopped existing at the last deploy. With no Cache-Control at all the browser
			# guesses from Last-Modified and caches exactly the wrong one of the two.
			@hashed path /assets/*
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			@unhashed not path /assets/*
			header @unhashed Cache-Control "no-cache"
			try_files {path} /index.html
			encode zstd gzip
			file_server
		}
	}
	@rtc host {$RTC_HOST}
	handle @rtc {
		import signaling
		respond 404
	}
	respond 404
}

http://:{$HOOKS_PORT:8090} {
	bind 127.0.0.1
	@hooks path /internal/tus /internal/livekit
	handle @hooks {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Internal-Secret {$INTERNAL_SECRET}
		}
	}
	respond 404
}
